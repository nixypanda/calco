# direnv
.direnv/

# env files
.env
.env.local
.env.*.local

# Local AI provider credentials (the matching TOML metadata is tracked).
assistant-config/*-api-key

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Nix result
result
result-*

# i18n code-generation cache (the generated Elm in frontend-web/generated is committed)
.cache/

# Import pipeline data
data/
data-fixed*/
!frontend-web/src/Data/
!frontend-web/src/Data/*.elm
!frontend-web/tests/Data/
!frontend-web/tests/Data/*.elm

# Python cache
__pycache__/
*.pyc
**/*.egg-info

**/apps/*.csv
**/apps/*.md
