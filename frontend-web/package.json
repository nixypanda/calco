{
  "name": "calco-frontend-web",
  "private": true,
  "type": "module",
  "scripts": {
    "version:write": "node -e \"const{execSync}=require('child_process');const{writeFileSync}=require('fs');let h=(process.env.CALCO_FRONTEND_VERSION||'').trim();if(!h){try{h=execSync('git rev-parse --short HEAD',{stdio:['ignore','pipe','ignore']}).toString().trim()}catch(e){h='dev'}}writeFileSync('public/version.json',JSON.stringify({version:h})+'\\n')\"",
    "prebuild": "npm run version:write",
    "predev": "npm run version:write",
    "dev": "vite",
    "build": "vite build",
    "coverage": "elm-coverage src --tests tests --silent",
    "preview": "vite preview"
  },
  "devDependencies": {
    "elm": "0.19.1-6",
    "elm-coverage": "^0.4.1",
    "vite": "^5.4.0",
    "vite-plugin-elm": "^3.0.0"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.0"
  }
}
