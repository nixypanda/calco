    "foodDetail.error.amountInvalid" : {
      "foodDetail.error.conflict" : {
        "foodDetail.error.differentServer" : {
          "foodDetail.error.notesTooLong" : {
            "foodDetail.error.rateLimited" : {
              "foodDetail.error.saveFailed" : {
                "localizations" : {
                  "en" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "CalCo could not save this attempt safely, so it was not sent. Try again."
